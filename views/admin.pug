doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Nyondo Hardware - Admin Dashboard
  link(rel='stylesheet' href='css/admin.css') 
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css')
.container
  aside.sidebar
    h2 Nyondo Hardware
    a.active(href='#')
      i.fas.fa-home
      span Dashboard
    a(href='/stocklist')
      i.fas.fa-boxes
      span Stock
    a(href='/saleslist')
      i.fas.fa-shopping-cart
      span Sales
    a(href='/deposit')
      i.fas.fa-wallet
      span Deposits
    a(href='/report')
      i.fas.fa-file-alt
      span Reports
    a(href='/signup')
      i.fas.fa-users
      span Register User
    a(href='/logout')
      i.fas.fa-sign-out-alt
      span Logout
  main.main
    .topbar
      h1 Admin Dashboard
      .admin-info
        i.fas.fa-user-circle
        span Admin
    section.cards
      .card
        i.fas.fa-money-bill-wave
        div
          h3 Stock Value
          p  UGX #{(stockValue || 0).toLocaleString()}
      .card
        i.fas.fa-shopping-cart
        div
          h3 Sales Today
          p  UGX #{(totalSales || 0).toLocaleString()}
      .card
        i.fas.fa-wallet
        div
          h3 Total Deposits
          p UGX #{(totalDeposits || 0).toLocaleString()}
      .card
        i.fas.fa-exclamation-triangle.low-stock-icon
        div
          h3 Low Stock Items
          p #{lowStockCount} Items
    section.section
      h2 Recent Deposits
      table
        thead
          tr
            th Customer
            th Item
            th Quantity
            th Item Price (UGX)
            th Total Price (UGX)
            th Amount Deposited (UGX)
            th Balance (UGX)
            th Status
            th Actions
        tbody
          each deposit in deposits
            tr 
              td= deposit.customername 
              td= deposit.itemname
              td= deposit.quantity 
              td= deposit.itemprice
              td UGX #{(deposit.quantity * deposit.itemprice).toLocaleString()}
              td UGX #{deposit.amountdeposited.toLocaleString()}
              td UGX #{deposit.balance.toLocaleString()}
              td 
                - const status = deposit.status || 'Pending'
                span(class=`status ${status.toLowerCase()}`)= status
              td 
                a.btn-edit(href=`/deposit/edit/${deposit._id}`)
                  i.fas.fa-pen 
                  | Edit
    section.section 
      h2 Registered Users 
      table 
        thead 
          tr 
            th Full Name 
            th Email Address
            th Phone Number 
            th Role 
            th Date Registered 
            th Actions
        tbody 
          each user in users 
            tr 
              td= user.fullname 
              td= user.email 
              td= user.phonenumber 
              td= user.role 
              td= new Date(user.date).toLocaleDateString()
              td 
                a.btn-edit(href=`/users/edit/${user._id}`)
                    i.fas.fa-pen 
                    | Edit
              td
                a.btn-delete(href=`/users/delete/${user._id}` onclick='return confirm("Do you want to delete this user?")')
                    i.fas.fa-trash