doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Nyondo Stock - Admin Dashboard
  link(rel='stylesheet' href='css/admin.css') 
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css')
.container
  aside.sidebar
    h2 Nyondo Stock
    a.active(href='#')
      i.fas.fa-chart-line
      span Dashboard
    a(href='stocklist')
      i.fas.fa-boxes
      span Stock
    a(href='saleslist')
      i.fas.fa-shopping-cart
      span Sales
    a(href='deposit')
      i.fas.fa-wallet
      span Deposits
    a(href='report')
      i.fas.fa-file-alt
      span Reports
    a(href='signup')
      i.fas.fa-users
      span Users
    a(href='logout')
      i.fas.fa-sign-out-alt
      span Logout
  main.main
    .topbar
      h1 Admin Dashboard
      .admin-info
        i.fas.fa-user-circle
        span Admin
    section.cards
      .card
        i.fas.fa-money-bill-wave
        div
          h3 Stock Value
          p  UGX #{(stockValue || 0).toLocaleString()}
      .card
        i.fas.fa-shopping-cart
        div
          h3 Sales Today
          p  UGX #{(totalSales || 0).toLocaleString()}
      .card
        i.fas.fa-wallet
        div
          h3 Total Deposits
          p UGX #{(totalDeposits || 0).toLocaleString()}
      .card
        i.fas.fa-exclamation-triangle
        div
          h3 Low Stock Items
          p #{lowStockCount} Items
    section.section
      h2 Recent Deposits
      table
        thead
          tr
            th Customer
            th Item
            th Quantity
            th Item Price
            th Deposited
            th Balance
            th Status
            th Actions
        tbody
          each deposit in deposits
            tr 
              td= deposit.customername 
              td= deposit.itemname
              td= deposit.quantity 
              td= deposit.itemprice
              td UGX #{deposit.amountdeposited.toLocaleString()}
              td UGX #{deposit.balance.toLocaleString()}
              td 
                - const status = deposit.status || 'Pending'
                span(class=`status ${status.toLowerCase()}`)= status
              td 
                a.btn-edit(href=`/deposit/edit/${deposit._id}`)
                  i.fas.fa-pen 
                  | Edit
