doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Deposit Scheme - Nyondo Stock
  link(rel='stylesheet' href='css/deposit.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
.sidebar
  h2 Nyondo Stock
  a(href='admindashboard')
    i.fas.fa-th-large
    | Dashboard
  a(href='/saleslist')
    i.fas.fa-shopping-cart
    | Sales
  a.active(href='/deposit')
    i.fas.fa-wallet
    | Deposits
  a(href='/report')
    i.fas.fa-chart-line
    | Reports
  a(href='credit')
    i.fas.fa-wallet
    | Deposit List
  a(href='logout')
    i.fas.fa-sign-out-alt
    | Logout
.main
  header.top-bar
    h1 Customer Deposit Scheme
  .deposit-grid
    .form-card
      h2 Record New Deposit
      form(action='/deposits' method='post')
        .form-group
          label Customer Name
          input(type='text' name='customername' placeholder='e.g. John Doe' required='')
        .form-group
          label NIN Number
          input(type='text' name='NINnumber' placeholder='Enter NIN (e.g. CM12345678ABCD)' required='' pattern='^[A-Z]{2}\\d{9}[A-Z]{4}$' maxlength='15' title='NIN must be 2 letters,9 digits,then 4 letters')
        .form-group
          label Phone Number
          input(type='text' name='phonenumber' placeholder='7xxxxxxxx' required='' pattern='[7][0-9]{8}' maxlength='9' inputmode='numeric' title='Enter a valid Ugandan number starting with 7 and 9 digits long')
        .form-group
          label Item Name
          select(name='itemname' required='')
            option(value='') Select Item
            option(value='Cement') Cement
            option(value='Ironbars') Iron bars
            option(value='Ironsheets') Iron sheets
        .form-group
          label Quantity
          input(type='number' name='quantity' placeholder='Enter quantity' required='')
        .form-group
          label Item Price
          input(type='number' name='itemprice' placeholder='Enter item price' required='')
        .form-group
          label Customer Address
          input(type='text' name='customeraddress' placeholder='Enter customer address' required='')
        .form-group
          label Distance (km)
          input(type='text' name='distance' placeholder='Enter distance' required='')
        .form-group
          label Amount to Deposit (UGX)
          input(type='number' name='amountdeposited' placeholder='Enter amount' required='')
        button.btn-deposit(type='submit') Confirm Deposit