doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Deposit Scheme - Nyondo Stock
  link(rel='stylesheet' href='/css/deposits.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
.sidebar
  h2 Nyondo Stock
  a(href='admindashboard')
    i.fas.fa-th-large
    | Dashboard
  a(href='/deposit')
    i.fas.fa-boxes
    | Deposits
  a(href='/salesform')
    i.fas.fa-shopping-cart
    | Sales
  a.active(href='/deposit')
    i.fas.fa-wallet
    | Deposits List
  a(href='#')
    i.fas.fa-chart-line
    | Reports
  a(href='logout')
    i.fas.fa-sign-out-alt
    | Logout
.main
  header.top-bar
    h1 Customer Deposit Scheme
    .stats-mini
      span
        | Total Pool: 
        strong UGX #{totalPool.toLocaleString()}
  .deposit-grid
    .table-card
      h2 Recent Contributions
      table
        thead
          tr
            th Customer
            th Contact
            th NIN Number
            th Customer Address 
            th Distance (km) 
            th Item Name 
            th Item Price
            th Quantity
            th Amount Deposited
            th Date
            th Balance
            th Status
            th Actions
        tbody
          each deposit in deposits
            tr
              td= deposit.customername
              td= deposit.phonenumber
              td= deposit.NINnumber
              td= deposit.customeraddress
              td= deposit.distance
              td= deposit.itemname
              td= deposit.itemprice
              td= deposit.quantity
              td= deposit.amountdeposited
              td= new Date(deposit.date).toLocaleDateString()
              td= deposit.balance
              td 
                //- - const status = deposit.status || 'Pending'
                - const status = (deposit.status || 'Pending').toLowerCase()
                span(class=`status ${status}`)= deposit.status || 'Pending'
                
                //- span(class=`status.toLowerCase()}`)= status