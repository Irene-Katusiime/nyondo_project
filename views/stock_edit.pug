doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Stock Management
  link(rel='stylesheet' href='/css/stockmanagement.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
.sidebar
  h2 Nyondo Hardware
  a(href='/stocklist')
    i.fas.fa-home
    | Dashboard
  a.active(href='/stocklist')
    i.fas.fa-boxes
    | Edit Stock
  a(href='/logout')
    i.fas.fa-sign-out-alt
    | Logout
.main
  header.header-section
    h1 Inventory &amp; Stock
  .stock-grid
    .card.form-card
      h2 Edit Stock
      form(action=`/stock/edit/${item._id}` method='post')
        .form-group-row
          .form-group
            label Quantity
            input(type='number' name='quantity' value=item.quantity placeholder='In Stock' required='')
        .form-group-row
          .form-group
            label Unit Price (UGX)
            input(type='number' name='unitprice' value=item.unitprice placeholder='Buying price' required='')
          .form-group
            label Selling Price (UGX)
            input#sellingprice(type='number' name='sellingprice' value=item.sellingprice placeholder='Retail price' required='')
          .form-group
            label Payment Method
            select(name='paymentmethod' required='')
              option(value='') Select payment method
              option(value='Cash' selected=item.paymentmethod==='Cash') Cash
              option(value='Credit' selected=item.paymentmethod==='Credit') Credit
        button(type='submit') Update Stock