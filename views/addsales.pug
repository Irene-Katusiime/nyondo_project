doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Nyondo sales
  link(rel='stylesheet' href='css/sales.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
// Sidebar
.sidebar
  h2 Nyondo Stock
  a(href='/saleslist')
    i.fas.fa-th-large
    | Dashboard
  //- a(href='#')
  //-   i.fas.fa-boxes
  //-   | Stock
  a.active(href='/salesform')
    i.fas.fa-shopping-cart
    | New Sale
  a(href='salesList')
    i.fas.fa-shopping-cart
    | Sales
  //- a(href='deposit')
  //-   i.fas.fa-wallet
  //-   | Deposits
  a(href='logout')
    i.fas.fa-sign-out-alt
    | Logout
// Main content
.main
  h1 Sales Management
  // sales form
  .form-container
    h2 Record Sale
    form(action='/cart/add' method='post')
      .form-group
        label Item Name
          select(name='itemId')
            option(value='' disabled selected) Select item 
            each item in items
              option(value=item._id) #{item.itemName} (stock: #{item.quantity} | price: #{item.sellingprice} UGX)
      .form-group
        label Quantity
        input(type='number' name='quantity' placeholder='Enter quantity' required='')
      .form-group
        label Unit Price (UGX)
        input(type='number' name='unitprice' placeholder='Enter price' required='')
      .form-group
        label Customer Name
        input(type='text' name='customername' placeholder='Enter customer name' required='')
      .form-group
        label Customer Contact
        input(type='text' name='customercontact' placeholder='7xxxxxxxx' required='' pattern='[7][0-9]{8}' maxlength='9' inputmode='numeric'  title='Enter a valid Ugandan number starting with 7 and 9 digits long')
      .form-group
        label Customer Address
        input(type='text' name='customeraddress' placeholder='Enter customer address' required='')
      .form-group
        label Customer Distance (km)
        input(type='number' name='customerdistance' placeholder='Enter customer distance' required='')
      .form-group
        label Payment Method
        select(name='paymentmethod' required='')
          option(value='') Select payment method 
          option(value='Cash') Cash 
          option(value='Mobile Money') Mobile Money

      button(type='submit') Add to Cart 

    //Shopping Cart
    .table-container 
      h2 Shopping Cart 

      if cart.length > 0
        table 
          thead 
            tr 
              th Item 
              th Quantity 
              th Unit Price (UGX)
              th Total (UGX)
              th Customer Name 
              th Customer Contact 
              th Customer Address
              th Customer Distance (km)
              th Payment Method
          tbody 
            each cartItem in cart 
              tr 
                td= cartItem.itemname ? cartItem.itemname: 'Unkown Item'
                td= cartItem.quantity
                td  #{(cartItem.unitprice || 0).toLocaleString()}
                td  #{(cartItem.total || 0).toLocaleString()}
                td= cartItem.customername 
                td= cartItem.customercontact 
                td= cartItem.customeraddress 
                td= cartItem.customerdistance
                td= cartItem.paymentmethod

      h3 Grand Total: UGX #{cartTotal.toLocaleString()}

      form(action='/cart/checkout' method='post')
        .form-group
          label Customer Name
          input(type='text' name='customername' required)

        .form-group
          label Customer Contact
          input(type='text' name='customercontact' required)

        .form-group
          label Customer Address
          input(type='text' name='customeraddress' required)

        .form-group
          label Distance
          input(type='number' name='customerdistance' required)
        
        .form-group 
          label.transport-label Transport Needed?
          select(name='needsTransport')
            option(value='') Choose either yes or no
            option(value='yes') Yes 
            option(value='no') No

        .form-group
          label Payment Method
          select(name='paymentmethod' required)
            option(value='') Select Payment Method
            option(value='Cash') Cash
            option(value='Mobile Money') Mobile Money

        button(type='submit') Checkout

        //- button(type='submit') Complete  Sale
    //- else 
    //- p No items in cart.