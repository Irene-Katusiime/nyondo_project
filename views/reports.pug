doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title NyondoStock | Reports
  link(rel='stylesheet' href='/css/reports.css')
  // FontAwesome for the specific icon indicators used in your framework
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
// Sidebar Layout
aside.sidebar
  .sidebar-branding
    i.fa-solid.fa-layer-group
    div
      h2 NyondoStock
      p Hardware Management
  nav.nav-menu
    a(href='/admindashboard')
      i.fas.fa-home
      |  Dashboard
    a(href='/stocklist')
      i.fa-solid.fa-boxes-stacked
      |  Inventory
    a(href='/sales')
      i.fa-solid.fa-cart-shopping
      |  Record Sale
    a.active(href='/reports')
      i.fa-solid.fa-file-invoice-dollar
      |  Reports
    a.logout(href='/logout')
      i.fa-solid.fa-right-from-bracket
      |  Logout
// Content Workspace
main.main-content
  header.top-bar
    .admin-profile
      .profile-pic A
      span.profile-name(style='color: var(--primary); font-weight: 600;') Admin
      a.export-btn(href='#' onclick='window.print(); return false;')
        i.fa-solid.fa-file-pdf 
        | Export PDF
  // Framework Metrics Grid
  section.stats-grid
    .stat-card
      .stat-info
        p  Gross Revenue
        h3 UGX #{stats.salesRevenue.toLocaleString()}

      i.fa-solid.fa-wallet
    .stat-card
      .stat-info
        p Cost of Goods (COGS)
        h3 UGX #{stats.costRevenue.toLocaleString()} 
      i.fa-solid.fa-boxes-stacked
    .stat-card
      .stat-info
        p Total Deposits
        h3 UGX #{(totalDeposits || 0).toLocaleString()}
      i.fa-solid.fa-hand-holding-dollar
  // Segment Navigation Submenu
  .report-tabs-menu
    button.tab-btn.active(onclick="toggleReportTab(event, 'sales-view')") Sales Performance
    button.tab-btn(onclick="toggleReportTab(event, 'stock-health-view')") Stock Health &amp; Alerts
    button.tab-btn(onclick="toggleReportTab(event, 'deposits-view')") Deposit Schemes Ledger
  // TAB 1: Sales Transactions
  #sales-view.tab-panel.active
    .table-container
      table
        thead
          tr
            th Item Name 
            th Quantity 
            th Unit Price 
            th Customer Name 
            th Customer Contact 
            th Attendant 
            th Date 
            th Total
        tbody
          each sale in sales
            tr
              td
                each item in sale.items 
                  div= item.itemname.itemName 
              td
                each item in sale.items 
                  div= item.quantity 
              td
                each item in sale .items 
                  div= item.unitprice 
              td= sale.customername 
              td= sale.customercontact 
              td= sale.attendant ? sale.attendant.fullname: ''
              td= new Date(sale.date).toLocaleDateString()
              td= sale.grandTotal.toLocaleString()
  // TAB 2: Inventory Safety Thresholds
  #stock-health-view.tab-panel
    .table-container
      table
        thead
          tr
            th Item Name 
            th Quantity
            th Unit Price (UGX)
            th Total (UGX)
            th Selling Price (UGX)
            th Date
            th Alert State
        tbody
          each item in stocks 
            tr 
              td= item.itemName 
              td= item.quantity
              td= item.unitprice
              td= item.total
              td= item.sellingprice
              td= new Date(item.datereceived).toLocaleDateString()
              td
                span(class=item.alertClass)= item.alertState
  // TAB 3: Customer Downpayments
  #deposits-view.tab-panel
    .table-container
      table
        thead
          tr
            th Customer Name
            th Customer Contact 
            th NIN Number 
            th Customer Address 
            th Distance (km)
            th Item Name 
            th Item Price
            th Quantity 
            th Amount Deposited 
            th Date 
            th Balance 
        tbody
          each deposit in deposits
            tr
              td= deposit.customername 
              td= deposit.phonenumber 
              td= deposit.NINnumber 
              td= deposit.customeraddress 
              td= deposit.distance 
              td= deposit.itemname 
              td= deposit.itemprice 
              td= deposit.quantity 
              td= deposit.amountdeposited 
              td= new Date(deposit.date).toLocaleDateString()
              td= deposit.balance
// Tab Control Core Logic
script.
  function toggleReportTab(event, targetPanelId) {
  const panels = document.querySelectorAll('.tab-panel');
  const buttons = document.querySelectorAll('.tab-btn');
  panels.forEach(panel => panel.classList.remove('active'));
  buttons.forEach(btn => btn.classList.remove('active'));
  document.getElementById(targetPanelId).classList.add('active');
  event.currentTarget.classList.add('active');
  }
