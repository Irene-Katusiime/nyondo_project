doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Stock Management - Nyondo Stock
  link(rel='stylesheet' href='css/stockmanagement.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
.sidebar
  h2 Nyondo Stock
  a(href='stocklist')
    i.fas.fa-th-large
    | Dashboard
  a.active(href='stocklist')
    i.fas.fa-boxes
    | Stock
  a(href='saleslist')
    i.fas.fa-shopping-cart
    | Sales
  a(href='#')
    i.fas.fa-wallet
    | Deposits
  a(href='logout')
    i.fas.fa-sign-out-alt
    | Logout
.main
  header.header-section
    h1 Inventory &amp; Stock
  .stock-grid
    .card.form-card
      h2 Register New Stock
      form(action='/stockreg' method='post')
        .form-group-row
          .form-group
            label Item Name
            select(name='itemName' required='')
              option(value='') Select Item 
              option(value='Cement') Cement
              option(value='Ironbars') Iron bars
              option(value='Nails') Nails
              option(value='Wheelbarrows') Wheelbarrows
              option(value='Wiremesh') Wire mesh
              option(value='Barbedwires') Barbed wires
              option(value='Ironsheets') Iron sheets
          .form-group
            label Factory Name
            input(type='text' name='factoryName' placeholder='Factory name' required='')
        .form-group-row
          .form-group
            label Category
            select(name='category' required='')
              option(value='') Select category
              option(value='Roofing') Roofing
              option(value='Cement/Binding') Cement/Binding
              option(value='Plumbing') Plumbing
              option(value='Electrical') Electrical
          .form-group
            label Quantity
            input(type='number' name='quantity' placeholder='In Stock' required='')
        .form-group-row
          .form-group
            label Unit Price (UGX)
            input(type='number' name='unitprice' placeholder='Buying price' required='')
          .form-group
            label Selling Price (UGX)
            input#sellingprice(type='number' name='sellingprice' placeholder='Retail price' required='')
        .form-group-row  
          .form-group
            label Supplier Name
            input(type='text' name='suppliername' placeholder='Enter supplier name' required='')
          .form-group
            label Supplier Contact
            input(type='text' name='suppliercontact' placeholder='7xxxxxxxx' required='' pattern='[7][0-9]{8}' maxlength='9' inputmode='numeric'  title='Enter a valid Ugandan number starting with 7 and 9 digits long')
          .form-group
            label Payment Method
            select(name='paymentmethod' required='')
              option(value='') Select payment method
              option(value='Mobilemoney') Mobile Money
              option(value='Cash') Cash
              option(value='Credit') Credit
        button(type='submit') Add Stock