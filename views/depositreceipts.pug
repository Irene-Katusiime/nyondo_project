doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title  Nyondo Receipt
  link(rel='stylesheet' href='/css/receipt.css')
  // Font Awesome for clean layout iconography
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
.receipt-wrapper
  // Action Control (Hidden during physical print execution)
  .no-print-actions
    button.btn-print(onclick='window.print()')
      i.fa-solid.fa-print
      |  Print Receipt
    a.btn-back(href='/credit') Back to Deposits 
  // Document Core Container
  .receipt-card
    // Company Branding / Header Info
    header.receipt-header
      .brand-block
        h1 Nyondo General Hardware
        p.tagline Quality Tools, Building Materials &amp; General Supplies
        p.contact-line
          i.fa-solid.fa-location-dot
          |  Plot 24, Complex Block, Kampala - Jinja Rd, Seeta
        p.contact-line
          i.fa-solid.fa-phone
          |  +256 767 954565 | +256 703 647896
      .document-badge
        h2 RECEIPT
        span.invoice-number #{deposit.invoiceNumber || 'INV-PENDING'}
    hr.divider
    // Transaction Metadata Grid
    section.meta-grid
      .meta-block
        h3 Issued To:
        p.client-name #{deposit.customername}
        p Address: #{deposit.customeraddress}
        p Tel: #{deposit.phonenumber}
      .meta-block.text-right
        h3 Transaction Details:
        p
          strong Date:
          |  #{new Date(deposit.date).toLocaleString()}
        p
          strong Served By:
          |  #{adminName}
    // Line Items Ledger Table
    table.receipt-table
      thead
        tr
          th Item Name
          th Quantity
          th Unit Cost (UGX)
          th Total Cost (UGX)
          th Amount Paid (UGX)
          //- th Balance (UGX)
      tbody
          tr 
            td= deposit.itemname 
            td= deposit.quantity
            td UGX #{deposit.itemprice.toLocaleString()}
            td UGX #{(deposit.quantity * deposit.itemprice).toLocaleString()}
            td UGX #{deposit.amountdeposited.toLocaleString()}
            //- td UGX #{deposit.balance.toLocaleString()}

    // Financial Calculation Totals Summary Section
    - const subtotal = deposit.quantity * deposit.itemprice
    - const transport = Number(deposit.transportcost || 0)
    - const grandTotal = subtotal + transport
    - const depositPaid = Number(deposit.amountdeposited || 0)
    - const balance = grandTotal - depositPaid
    section.totals-section
      .calculations-box
        .calc-row
          span Subtotal:
          span UGX #{subtotal.toLocaleString()}
        .calc-row
          span Transport:
          span UGX #{transport.toLocaleString()}
        .calc-row.total-row
          span Grand Total:
          span UGX #{grandTotal.toLocaleString()}
        .calc-row.highlight-paid
          span Amount Paid Today:
          span UGX #{depositPaid.toLocaleString()}
        .calc-row.highlight-balance
          span Outstanding Balance:
          span UGX #{balance.toLocaleString()}
        .calc-row 
    hr.divider
    // Footnote / Verification Section
    footer.receipt-footer
      p.thanks-message Thank you for doing business with Nyondo General Hardware!
      p
        | Goods once cleared and collected in full cannot be returned after 7 business days.
    //-   .stamp-signature-area
    //-     .sign-line Issued Stamp / Signature
