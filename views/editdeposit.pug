doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Deposit Scheme - Nyondo Hardware
  link(rel='stylesheet' href='/css/deposit.css')
  link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
.sidebar
  h2 Nyondo Hardware
  a(href='/admindashboard')
    i.fas.fa-home
    | Dashboard
  a(href='/saleslist')
    i.fas.fa-shopping-cart
    | Sales
  a.active(href='/deposit')
    i.fas.fa-wallet
    | Edit Deposits
  a(href='/report')
    i.fas.fa-chart-line
    | Reports
  a(href='/credit')
    i.fas.fa-wallet
    | Deposit List
  a(href='logout')
    i.fas.fa-sign-out-alt
    | Logout
.main
  header.top-bar
    h1 Customer Deposit Scheme
  .deposit-grid
    .form-card
      h2 Edit Deposit
      form(action=`/deposit/update/${deposit._id}`, method='post')
        .form-group
          label Customer Name
          input(type='text' name='customername' value=deposit.customername)
        .form-group
          label Quantity
          input(type='number' name='quantity' value=deposit.quantity)
        .form-group
          label Item Name
          input(type='text' name='itemname' value=deposit.itemname)
        .form-group
          label Item Price
          input(type='number' name='itemprice' value=deposit.itemprice)
        .form-group
          label Additional Payment (UGX)
          input(type='number' name='newpayment' min='0' required)
        .form-group
          label Current Balance
          input(type='number' value=deposit.balance readonly)
        button.btn-deposit(type='submit') Update Deposit