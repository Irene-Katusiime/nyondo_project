doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Nyondo Sign Up
link(rel='stylesheet' href='/css/sign.css')
.signup-container
  h2 Create Account
  // This is a form
  form#signupForm(action='/signup' method='post')
    .form-group
      label Full Name
      input(type='text' name='fullname' placeholder='Enter your full name')
    .form-group
      label Email
      input(type='email' name='email' placeholder='example@gmail.com')
    .form-group
      label NIN
      input(type='text' name='nin' placeholder='Enter NIN (e.g. CM123456789ABCD)' pattern='^[A-Z]{2}\\d{9}[A-Z]{4}$' maxlength='15' title='NIN must be 2 letters,9 digits,then 4 letters')
    .form-group
      label Phone number
      input(type='text' name='phonenumber' placeholder='7xxxxxxxx' pattern='[7][0-9]{8}' maxlength='9' inputmode='numeric' title='Enter a valid Ugandan number starting with 7 and 9 digits long')
    .form-group
      label Role
      select(name='role')
        option(value='') Select user role
        option(value='admin') Admin
        option(value='store manager') Store manager
        option(value='sales attendant') Sales attendant
    .form-group
      label Password
      input(type='password' name='password' placeholder='Enter password')
    button.signup-btn Sign Up
    .extra
      a.signup-btn(href='/admindashboard') Back 
script.
    console.log("Signup JS is running");

    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("signupForm").addEventListener("submit", function (e) {
            const inputs = this.querySelectorAll("input, select");

            let hasEmpty = false;

            inputs.forEach(input => {
                if (!input.value.trim()) {
                    input.classList.add("error");
                    hasEmpty = true;
                } else {
                    input.classList.remove("error");
                }
            });

            if (hasEmpty) {
                e.preventDefault();
            }
        });
    });

